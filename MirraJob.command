#!/bin/bash
# ============================================================
#  Mirra Job — запуск одним кликом (macOS)
#  Двойной клик по этому файлу запускает сервер и открывает браузер.
#  Чтобы остановить — закрой окно Терминала или нажми Ctrl+C.
# ============================================================

cd "$(dirname "$0")"
PORT=8765

# Уже запущен?
if curl -s -o /dev/null "http://localhost:${PORT}/" 2>/dev/null; then
  echo "Mirra Job уже запущен."
  open "http://localhost:${PORT}/"
  exit 0
fi

# Открываем браузер через секунду после запуска (в фоне)
( sleep 1.2; open "http://localhost:${PORT}/" ) &

echo "Запускаю Mirra Job…"
echo "Страница откроется в браузере: http://localhost:${PORT}"
echo ""
echo "Остановка: Ctrl+C или закрыть это окно."
echo "============================================================"

# Запускаем сервер на переднем плане
python3 job_search/server.py
